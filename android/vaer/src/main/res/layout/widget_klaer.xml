<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bakgrunn"
    android:orientation="vertical"
    android:padding="@dimen/waddle_space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ikon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/waddle_space_2"
            android:src="@drawable/ic_cloud"
            android:tint="@color/waddle_text" />

        <TextView
            android:id="@+id/tittel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/waddle_mono_bold"
            android:text="I morgen"
            android:textColor="@color/waddle_text"
            android:textSize="@dimen/waddle_text_base" />

        <TextView
            android:id="@+id/temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/waddle_mono_bold"
            android:textColor="@color/waddle_text"
            android:textSize="@dimen/waddle_text_base" />
    </LinearLayout>

    <TextView
        android:id="@+id/regn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/waddle_mono_bold"
        android:textColor="@color/waddle_accent"
        android:textSize="@dimen/waddle_text_sm" />

    <TextView
        android:id="@+id/klaer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/waddle_space_1"
        android:fontFamily="@font/waddle_mono"
        android:text="Henter været"
        android:textColor="@color/waddle_text"
        android:textSize="@dimen/waddle_text_sm" />
</LinearLayout>
